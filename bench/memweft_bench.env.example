# MemWeft benchmark configuration (copy to bench/memweft_bench.env)

# Rust bench sizing
MEMWEFT_BENCH_EXTENDED=1
MEMWEFT_BENCH_EXTREME=0
MEMWEFT_BENCH_EVENTS_SCALES=1000000,5000000,10000000,20000000,50000000
MEMWEFT_BENCH_SQLITE_MAX_EVENTS=1000000
MEMWEFT_BENCH_SQLITE_EVENT_CHUNK=10000
MEMWEFT_BENCH_SQLITE_MODE=auto
MEMWEFT_BENCH_SQLITE_DIR=target/bench_sqlite
# MEMWEFT_BENCH_SQLITE_FILE=/tmp/memweft_bench.db
MEMWEFT_BENCH_WRITE_EVENTS_SCALES=100000,300000,1000000
MEMWEFT_BENCH_WRITE_FACT_SCALES=200,1000,5000
MEMWEFT_BENCH_BULK_EVENTS_SCALES=10000,100000
MEMWEFT_BENCH_BULK_EVENT_BATCH=500
MEMWEFT_BENCH_RESET_DB=1

# Database DSNs
MEMWEFT_BENCH_MYSQL_DSN=mysql://user:pass@127.0.0.1:3306/memweft
MEMWEFT_BENCH_POSTGRES_DSN=postgres://user:pass@127.0.0.1:5432/memweft
MEMWEFT_BENCH_MYSQL_MAX_EVENTS=50000000
MEMWEFT_BENCH_POSTGRES_MAX_EVENTS=50000000

# Python benchmark defaults
MEMWEFT_BENCH_EVENTS=2000
MEMWEFT_BENCH_ITERATIONS=30
MEMWEFT_BENCH_LIST_LIMIT=50

# Python load test defaults
MEMWEFT_LOAD_DURATION=300
MEMWEFT_LOAD_CONCURRENCY=32
MEMWEFT_LOAD_SEED_EVENTS=200000
MEMWEFT_LOAD_LIST_LIMIT=200
MEMWEFT_LOAD_APPEND_RATIO=0.3
MEMWEFT_LOAD_LIST_RATIO=0.4
MEMWEFT_LOAD_BUILD_RATIO=0.3
MEMWEFT_LOAD_MAX_SAMPLES=10000
MEMWEFT_LOAD_MYSQL_DSN=mysql://user:pass@127.0.0.1:3306/memweft
MEMWEFT_LOAD_POSTGRES_DSN=postgres://user:pass@127.0.0.1:5432/memweft

# Python soak test defaults
MEMWEFT_SOAK_DURATION=3600
MEMWEFT_SOAK_INTERVAL=60
MEMWEFT_SOAK_SEED_EVENTS=200000
MEMWEFT_SOAK_LIST_LIMIT=200
MEMWEFT_SOAK_APPEND_RATIO=0.3
MEMWEFT_SOAK_LIST_RATIO=0.4
MEMWEFT_SOAK_BUILD_RATIO=0.3
MEMWEFT_SOAK_MYSQL_DSN=mysql://user:pass@127.0.0.1:3306/memweft
MEMWEFT_SOAK_POSTGRES_DSN=postgres://user:pass@127.0.0.1:5432/memweft
