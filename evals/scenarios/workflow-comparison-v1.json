        },
        {
          "op": "remember",
          "key": "render_acceptance",
          "value": "当前交付包的画面检查与版权检查均已通过。"
        },
        {
          "op": "remember",
          "key": "campaign_receiver",
          "value": "投放项目接收组代码为 media-intake-8。"
        },
        {
          "op": "remember",
          "key": "campaign_dependency",
          "value": "投放项目还在等待制作项目移交交付包，其他上线准备已完成。"
